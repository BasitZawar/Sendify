        <TextView
            android:id="@+id/infoText"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_gravity="center"
            android:layout_marginHorizontal="@dimen/_10sdp"
            android:layout_marginBottom="@dimen/_20sdp"
            android:background="@drawable/tab_shape"
            android:drawableStart="@drawable/ic_launcher_background"
            android:drawablePadding="@dimen/_10sdp"
            android:gravity="start"
            android:paddingVertical="@dimen/_8sdp"
            android:paddingStart="@dimen/_10sdp"
            android:paddingEnd="@dimen/_2sdp"
            android:text="to_optimize_the_data_transfer_process_please_ensure_both_devices_are_connected_to_the_same_wi_fi_network"
            android:textColor="#241F39"
            android:textSize="@dimen/_10sdp"
            app:layout_constraintBottom_toTopOf="@+id/btn_retry"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <TextView
            android:id="@+id/btn_retry"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/_18sdp"
            android:layout_marginBottom="@dimen/_16sdp"
            android:background="@drawable/tab_shape"
            android:gravity="center"
            android:paddingVertical="@dimen/_8sdp"
            android:text="retry_connection"
            android:textColor="@color/white"
            android:textSize="@dimen/_12sdp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
